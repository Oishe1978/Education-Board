<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="450.0" prefWidth="400.0" spacing="12.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Student.RegistrationController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Examination Registration">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <Label text="Select Exam Type:" />
        <ComboBox fx:id="examTypeCombo" prefWidth="250.0" promptText=" Choose Examination " />
        <Label text="Available Mandatory &amp; Elective Subjects:" />
        <ListView fx:id="subjectListView" prefHeight="120.0" prefWidth="360.0" />
        <CheckBox fx:id="verifyCheck" mnemonicParsing="false" text="I verify that my profile profile info is accurate." wrapText="true" />
        <Button mnemonicParsing="false" onAction="#handleSubmitRegistration" prefWidth="180.0" text="Submit Registration Form" />
        <Label fx:id="confLabel" textFill="#136920" wrapText="true" />
    </children>
</VBox>
