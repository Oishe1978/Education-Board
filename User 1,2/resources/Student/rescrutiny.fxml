<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10.0" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Student.ReScrutinyController">
    <Label text="Apply for Paper Re-Scrutiny" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    <Label text="Select eligible subjects for evaluation review:"/>
    <ListView fx:id="eligibleSubjectsList" prefHeight="120"/>
    <Button text="Submit Application" onAction="#handleSubmitApplication"/>
    <Label fx:id="confirmationLabel" textFill="BLUE"/>
</VBox>