<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://fxml.com/1" fx:controller="controller.ScheduleController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <children>
        <Label text="Examination Schedule Center" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
        <HBox spacing="10">
            <ComboBox fx:id="examSelectCombo" promptText="Choose Exam"/>
            <Button text="Load Schedule" onAction="#handleLoadSchedule"/>
        </HBox>
        <TextArea fx:id="scheduleDetailsDisplay" editable="false" prefHeight="150"/>
    </children>
</VBox>