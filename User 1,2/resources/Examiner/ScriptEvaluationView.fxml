<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="342.0" prefWidth="368.0" spacing="15" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ScriptEvaluationController">
    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
    <children>
        <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Script Evaluation Board" />
        <GridPane hgap="10" vgap="10">
            <children>
                <Label text="Script ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="scriptIdInput" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label text="Section A Marks:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="marksAInput" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label text="Section B Marks:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="marksBInput" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </children>
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>
        <Button onAction="#handleCalculateAndSave" style="-fx-background-color: green; -fx-text-fill: white;" text="Calculate Total &amp; Save" />
        <Label fx:id="totalMarksLabel" style="-fx-font-weight: bold;" text="Calculated Total: 0.0" />
        <Label fx:id="statusLabel" style="-fx-font-style: italic;" text="System status: Ready" />
    </children>
</VBox>
