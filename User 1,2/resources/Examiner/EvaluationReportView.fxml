<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="218.0" prefWidth="289.0" spacing="10" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.EvaluationReportController">
    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
    <children>
        <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Performance Report Analyst" />
        <ComboBox fx:id="subjectCombo" promptText="Select Subject Package" />
        <Button onAction="#handleGenerateReport" text="Generate Analytic Report" />
        <Label fx:id="progressLabel" style="-fx-text-fill: green;" />
    </children>
</VBox>
