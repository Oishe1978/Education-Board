<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10.0" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ResultController">
    <Label text="Published Examination Results" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    <ComboBox fx:id="yearCombo" promptText="Select Exam Year"/>
    <Button text="View Result" onAction="#handleFetchResult"/>
    <TableView fx:id="resultTable" prefHeight="150" visible="false">
        <columns>
            <TableColumn fx:id="subCol" text="Subject"/>
            <TableColumn fx:id="gradeCol" text="Grade"/>
            <TableColumn fx:id="marksCol" text="Marks"/>
        </columns>
    </TableView>
    <Button fx:id="downloadBtn" text="Download Marksheet" onAction="#handleDownloadResult" visible="false"/>
</VBox>